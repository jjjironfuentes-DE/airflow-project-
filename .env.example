# Airflow
AIRFLOW_UID=50000

# IMDb RapidAPI: replace with your own key
RAPIDAPI_KEY=your_rapidapi_key_here

# SMTP: use your email and app password
AIRFLOW_SMTP_USER=your-email@example.com
AIRFLOW_SMTP_PASSWORD=your_smtp_app_password_here
AIRFLOW_SMTP_MAIL_FROM=your-email@example.com

# Local PostgreSQL settings
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_this_local_password
